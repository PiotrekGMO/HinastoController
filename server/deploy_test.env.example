# Settings for uploading the Hinasto Controller server to a TEST server over FTPS/SFTP with deploy_test.cmd.
# deploy_test.cmd copies this file to deploy_test.env - fill in the user name and password there.
# deploy_test.env is excluded from git and from the Docker image. Write the values without quotes.

FTP_PROTOCOL=ftps
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# a directory of its own for the site on the server.
# Point the document root of the web site at <FTP_REMOTE_DIR>/public: the rest of the application lies next to it,
# not reachable from the internet.
FTP_REMOTE_DIR=/web/hinasto

# no  = explicit FTPS (AUTH TLS on port 21), the usual setting
# yes = implicit FTPS (usually port 990)
FTP_IMPLICIT=no

# items that exist only on the server and must survive the swap of the version:
# storage = config.php written by the installer (database password, hash of the admin password)
KEEP=storage

# address of the site after the upload (only used for the final message)
SITE_URL=https://hinasto.example.com/

# permission mode of storage/ and public/api/v1 after every upload. 777 works on every host; where PHP runs as the FTP user
# (or shares its group) use 775 or 755: a world-writable folder lets other accounts of a shared host change config.php.
# STORAGE_MODE=777
